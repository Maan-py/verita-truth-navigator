				{
					"name": "Update Report Status",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Check if report_id is set",
									"var reportId = pm.environment.get(\"report_id\");",
									"if (!reportId || reportId === \"\") {",
									"    console.warn(\"⚠️  report_id is not set. Please run 'Get All Reports' or 'Create Report' first.\");",
