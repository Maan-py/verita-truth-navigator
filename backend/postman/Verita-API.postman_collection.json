		{
			"name": "Reports",
			"item": [
				{
					"name": "Create Report",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.id) {",
									"        pm.environment.set(\"report_id\", jsonData.data.id);",
									"        console.log(\"Auto-set report_id to:\", jsonData.data.id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"content\": \"This is a suspicious claim that needs verification. Please check if this is true or false.\",\n  \"image_url\": \"https://example.com/image.jpg\",\n  \"category\": \"health\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/reports",
							"host": ["{{base_url}}"],
							"path": ["api", "reports"]
						}
					},
					"response": []
				},
				{
					"name": "Get User Reports",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.length > 0) {",
									"        // Auto-set first report ID for testing",
									"        pm.environment.set(\"report_id\", jsonData.data[0].id);",
									"        console.log(\"Auto-set report_id to:\", jsonData.data[0].id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/reports",
							"host": ["{{base_url}}"],
							"path": ["api", "reports"]
						}
					},
					"response": []
				},
				{
					"name": "Get Report by ID",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Check if report_id is set",
									"var reportId = pm.environment.get(\"report_id\");",
									"if (!reportId || reportId === \"\") {",
									"    console.warn(\"⚠️  report_id is not set. Please run 'Create Report' or 'Get User Reports' first.\");",
									"    console.warn(\"You can also set it manually in environment variables.\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/reports/:id",
							"host": ["{{base_url}}"],
							"path": ["api", "reports", ":id"],
							"variable": [
								{
									"key": "id",
									"value": "{{report_id}}",
									"description": "Report ID from 'Create Report' or 'Get User Reports' response"
								}
							]
						},
						"description": "Get a specific report by ID. Make sure to run 'Create Report' or 'Get User Reports' first to auto-set report_id."
					},
					"response": []
				}
			]
		},
