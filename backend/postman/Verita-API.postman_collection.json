							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"FACT\",\n  \"verification_notes\": \"Verified against official government sources. This information is accurate.\",\n  \"category\": \"health\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/admin/reports/:id/status",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "reports", ":id", "status"],
							"variable": [
								{
									"key": "id",
									"value": "{{report_id}}",
									"description": "Report ID from 'Get All Reports' or 'Create Report' response"
								}
							]
						},
						"description": "Update report verification status. Make sure to run 'Get All Reports' or 'Create Report' first to auto-set report_id."
					},
					"response": []
				},
				{
					"name": "Get Report Statistics",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/admin/reports/stats",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "reports", "stats"]
						}
					},
					"response": []
				}
			]
		},
