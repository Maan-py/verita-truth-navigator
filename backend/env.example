# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Secret (generate a random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:8080

# Supabase Configuration
# Get these from Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Instructions:
# 1. Copy this file to .env
# 2. Replace SUPABASE_URL with your Supabase project URL
# 3. Replace SUPABASE_SERVICE_ROLE_KEY with your Service Role Key
# 4. Generate a strong JWT_SECRET (use: openssl rand -base64 32)

